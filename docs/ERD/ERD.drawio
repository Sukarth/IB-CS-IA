string description\n        int teacher_id FK\n        datetime created_at\n        bool is_archived\n    }\n    ENROLLMENTS {\n        int id PK\n        int classroom_id FK\n        int student_id FK\n        datetime joined_at\n    }\n    ASSIGNMENTS {\n        int id PK\n        int classroom_id FK\n        string type \&quot;ESSAY | PROBLEMSET | PROJECT\&quot;\n        string title\n        string description\n        datetime deadline\n        float effort_hours\n        int difficulty \&quot;1-5\&quot;\n        bool is_published\n        datetime created_at\n        int word_limit \&quot;ESSAY only\&quot;\n        int number_of_problems \&quot;PROBLEMSET only\&quot;\n        int min_group_size \&quot;PROJECT only\&quot;\n        int max_group_size \&quot;PROJECT only\&quot;\n    }\n    MATERIALS {\n        int id PK\n        int classroom_id FK\n        string title\n        string description\n        int uploaded_by FK\n        datetime uploaded_at\n    }\n    SUBMISSIONS {\n        int id PK\n        int student_id FK\n        int assignment_id FK\n        datetime submitted_at\n        int version\n        string feedback\n    }\n    ATTACHMENTS {\n        int id PK\n        string kind \&quot;FILE | LINK\&quot;\n        int material_id FK \&quot;exactly one of material_id/submission_id (XOR)\&quot;\n        int submission_id FK \&quot;exactly one of submission_id/material_id (XOR)\&quot;\n        string stored_filename \&quot;FILE only. Uuid filename on server disk\&quot;\n        string original_filename \&quot;FILE only. Name shown to user\&quot;\n        string mime_type \&quot;FILE only\&quot;\n        int file_size_kb \&quot;FILE only\&quot;\n        string url \&quot;LINK only\&quot;\n        string link_title \&quot;LINK only\&quot;\n        int uploaded_by FK\n        datetime uploaded_at\n    }\n    PROGRESS_RECORDS {\n        int id PK\n        int student_id FK\n        int assignment_id FK\n        string status \&quot;NOT_STARTED | IN_PROGRESS | COMPLETED | NEEDS_HELP\&quot;\n        datetime status_changed_at\n        string notes\n    }\n    HELP_REQUESTS {\n        int id PK\n        int student_id FK\n        int assignment_id FK\n        string message\n        datetime created_at\n        bool is_urgent\n        datetime resolved_at \&quot;nullable\&quot;\n        int resolved_by_id FK \&quot;nullable\&quot;\n        string resolution_notes \&quot;nullable\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hmTw_zo0YxLHXduEut6X-1">
