    USERS ||--o{ CLASSROOMS : "teaches"
    CLASSROOMS ||--o{ ENROLLMENTS : "has"
    USERS ||--o{ ENROLLMENTS : "joins"
    CLASSROOMS ||--o{ ASSIGNMENTS : "contains"
    CLASSROOMS ||--o{ MATERIALS : "stores"
    USERS ||--o{ MATERIALS : "uploads"
    MATERIALS ||--o{ ATTACHMENTS : "has"
    USERS ||--o{ SUBMISSIONS : "submits"
    ASSIGNMENTS ||--o{ SUBMISSIONS : "receives"
    SUBMISSIONS ||--o{ ATTACHMENTS : "has"
    USERS ||--o{ PROGRESS_RECORDS : "has"
    ASSIGNMENTS ||--o{ PROGRESS_RECORDS : "tracked by"
    USERS ||--o{ HELP_REQUESTS : "raises"
    ASSIGNMENTS ||--o{ HELP_REQUESTS : "concerns"
