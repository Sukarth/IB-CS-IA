classDiagram
direction LR

class UserRole {
  <<enumeration>>
  STUDENT
  TEACHER
  ADMIN
}

class ProgressStatus {
  <<enumeration>>
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_HELP
}

class AssignmentType {
  <<enumeration>>
  ESSAY
  PROBLEMSET
  PROJECT
}

class User {
  <<abstract>>
  +id: int
  +name: str
  +email: str
  +password_hash: str
  +role: UserRole
  +is_active: bool
  +created_at: datetime
  +get_by_id(id: int) User$
  +authenticate(email: str, password: str) User$
  +register(name: str, email: str, password: str, activation_key: str) User$
  +update_profile(name: str, email: str)
  +change_password(old_password: str, new_password: str)
  +deactivate()
}

class Student {
  +year_group_id: int | None = None
  +get_enrolled_classrooms() list~Classroom~
  +set_status(assignment: Assignment, status: ProgressStatus)
  +request_help(assignment: Assignment, message: str, urgent: bool)
  +submit_work(assignment: Assignment) Submission
}

class Teacher {
  +owned_classrooms: list~Classroom~
  +create_classroom(name: str, description: str) Classroom
  +get_help_queue() Queue
  +get_priority_queue() PriorityQueue
}

class Admin {
  +list_users(role: UserRole) list~User~
  +list_classrooms() list~Classroom~
}

class ActivationKey {
  +id: int
  +key_hash: str
  +role_to_assign: UserRole
  +year_group_id: int | None = None
  +created_by_id: int
  +created_at: datetime
  +expires_at: datetime
  +is_used: bool
  +used_by_id: int | None = None
  +used_at: datetime | None = None
  +generate(role: UserRole, created_by: Admin, valid_days: int, year_group_id: int | None = None) str$
  +generate_batch(role: UserRole, count: int, created_by: Admin, valid_days: int, year_group_id: int | None = None) list~str~$
  +validate(activation_key: str) ActivationKey$
  +mark_used(user: User)
  +delete()
}

class YearGroup {
  +id: int
  +name: str
  +create(name: str) YearGroup$
  +rename(new_name: str)
  +add_student(student: Student)
  +remove_student(student: Student)
  +get_students() list~Student~
  +delete()
}

class Classroom {
  +id: int
  +name: str
  +description: str
  +teacher_id: int
  +is_archived: bool
  +students: list~Student~
  +assignments: list~Assignment~
  +materials: list~Material~
  +get_by_id(id: int) Classroom$
  +create(name: str, description: str, teacher: Teacher) Classroom$
  +update(name: str, description: str)
  +archive()
  +enroll_student(student: Student)
  +unenroll_student(student: Student)
  +add_material(title: str, description: str, uploaded_by: User) Material
}

class Enrollment {
  +id: int
  +joined_at: datetime
  +classroom_id: int
  +student_id: int
}

class Assignment {
  <<abstract>>
  +id: int
  +classroom_id: int
  +title: str
  +description: str
  +deadline: datetime
  +effort_hours: float
  +difficulty: int
  +is_published: bool
  +get_by_id(id: int) Assignment$
  +update(title: str, description: str, deadline: datetime, effort_hours: float, difficulty: int)
  +publish()
  +unpublish()
  %% only deletes if the assignment has no submissions or help requests. Unpublished otherwise:
  +delete() 
  +get_completion() CompletionStats
  +days_remaining() int
  +get_type() AssignmentType
  +get_type_specific_details() dict
  +split_effort() list~WorkChunk~
}

class WorkChunk {
  +label: str
  +hours: float
}

class Essay {
  +word_limit: int
  +create(classroom: Classroom, title: str, description: str, deadline: datetime, effort_hours: float, difficulty: int, word_limit: int) Essay$
  +get_type_specific_details() dict
  +split_effort() list~WorkChunk~
}

class ProblemSet {
  +number_of_problems: int
  +create(classroom: Classroom, title: str, description: str, deadline: datetime, effort_hours: float, difficulty: int, number_of_problems: int) ProblemSet$
  +get_type_specific_details() dict
  +split_effort() list~WorkChunk~
}

class Project {
  +min_group_size: int
  +max_group_size: int
  +create(classroom: Classroom, title: str, description: str, deadline: datetime, effort_hours: float, difficulty: int, min_group_size: int, max_group_size: int) Project$
  +get_type_specific_details() dict
  +split_effort() list~WorkChunk~
}

class CompletionStats {
  +total_students: int
  +completion_count: int
  +completion_percentage: float
  +completed_students: list~Student~
  +pending_students: list~Student~
  +first_submission_at: datetime | None = None 
  +last_submission_at: datetime | None = None 
}

class Material {
  +id: int
  +classroom_id: int
  +title: str
  +description: str
  +uploaded_by: int
  +attachments: list~Attachment~
  +create(classroom: Classroom, title: str, description: str, uploaded_by: User) Material$
  +update(title: str, description: str)
  +attach_file(stored_filename: str, original_filename: str, mime_type: str, file_size_kb: int, uploaded_by: User) FileAttachment
  +attach_link(url: str, link_title: str, uploaded_by: User) LinkAttachment
  +remove_attachment(attachment: Attachment)
  +delete()
}

class Attachment {
  <<abstract>>
  +id: int
  +uploaded_by: int
  +uploaded_at: datetime
  +delete()
}

class FileAttachment {
  +stored_filename: str
  +original_filename: str
  +mime_type: str
  +file_size_kb: int
}

class LinkAttachment {
  +url: str
  +link_title: str
}

class ProgressRecord {
  +id: int
  +student_id: int
  +assignment_id: int
  +status: ProgressStatus
  +status_changed_at: datetime
  +notes: str
  +get_progress(student: Student, assignment: Assignment) ProgressRecord$
  +set_status(status: ProgressStatus)
  +add_note(note: str)
}

class Submission {
  +id: int
  +student_id: int
  +assignment_id: int
  +submitted_at: datetime
  +version: int
  +feedback: str
  +attachments: list~Attachment~
  +create(student: Student, assignment: Assignment) Submission$
  +attach_file(stored_filename: str, original_filename: str, mime_type: str, file_size_kb: int) FileAttachment
  +attach_link(url: str, link_title: str) LinkAttachment
  +add_feedback(feedback: str)
}

class HelpRequest {
  +id: int
  +student_id: int
  +assignment_id: int
  +message: str
  +created_at: datetime
  +is_urgent: bool
  +resolved_at: datetime | None = None 
  +resolution_notes: str | None = None 
  +resolved_by_id: int | None = None
  +create(student: Student, assignment: Assignment, message: str, is_urgent: bool) HelpRequest$
  +days_remaining() int
  +resolve(teacher: Teacher, resolution_notes: str)
}

User <|-- Student
User <|-- Teacher
User <|-- Admin
Assignment <|-- Essay
Assignment <|-- ProblemSet
Assignment <|-- Project
Attachment <|-- FileAttachment
Attachment <|-- LinkAttachment

Teacher "1" --> "0..*" Classroom : owns
Classroom "1" *-- "0..*" Enrollment : enrolls
Student "1" --> "0..*" Enrollment : is enrolled in
Student "0..*" --> "0..1" YearGroup : belongs to
Classroom "1" *-- "0..*" Assignment : contains
Classroom "1" *-- "0..*" Material : contains
Assignment ..> CompletionStats : lists
Material "1" *-- "0..*" Attachment : attaches
Submission "1" *-- "0..*" Attachment : attaches
Student "1" --> "0..*" ProgressRecord : records
Assignment "1" --> "0..*" ProgressRecord : lists
Student "1" --> "0..*" Submission : submits
Assignment "1" --> "0..*" Submission : receives
Student "1" --> "0..*" HelpRequest : creates
Assignment "1" --> "0..*" HelpRequest : lists
Teacher ..> HelpRequest : resolves
Admin ..> ActivationKey : generates
ProgressRecord ..> ProgressStatus : indicates
User ..> UserRole : has
Assignment ..> AssignmentType : can have
Assignment ..> WorkChunk : produces
StudyScheduler ..> WorkChunk : schedules
ActivationKey "0..*" --> "0..1" YearGroup : assigns on registration
ActivationKey "0..1" --> "0..1" User : creates